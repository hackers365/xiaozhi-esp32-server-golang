# 构建阶段
FROM golang:1.24-alpine AS builder

WORKDIR /build

# 安装必要的系统依赖
RUN apk add --no-cache git ca-certificates tzdata

# 复制依赖的模块与源代码（保持相对路径层级满足 go.mod 中的 replace 规则）
COPY go.mod go.sum ./
COPY pkg/ ./pkg/
COPY manager/backend/ ./manager/backend/

WORKDIR /build/manager/backend

# 构建应用
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main .

# 运行阶段
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /root/

# 从构建阶段复制二进制文件
COPY --from=builder /build/manager/backend/main .
COPY --from=builder /build/manager/backend/config ./config

# 设置时区
ENV TZ=Asia/Shanghai

EXPOSE 8080

CMD ["./main"]
